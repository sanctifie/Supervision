# --- Accès -------------------------------------------------------------------
# Mot de passe de l'interface (obligatoire en production).
SUPERVISION_MOT_DE_PASSE=
# Durée d'une session, en heures.
SUPERVISION_SESSION_HEURES=12
# true si l'interface est servie en HTTPS (derrière Caddy).
COOKIE_SECURISE=false

# --- Sources -----------------------------------------------------------------
# auto : Prometheus s'il répond, sinon démonstration. reel | demo pour forcer.
SUPERVISION_MODE=auto
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
LOKI_URL=http://loki:3100
# Lien « Ouvrir Grafana » (facultatif), ex. https://officine.exemple.ga/supervision/
GRAFANA_URL=

# --- Officine ------------------------------------------------------------------
NOM_PRODUIT=Officina
FUSEAU=Africa/Libreville
# Heures d'ouverture : « zéro vente pendant 1 h » n'alerte qu'entre ces heures.
HEURE_OUVERTURE=8
HEURE_FERMETURE=20

# --- Docker --------------------------------------------------------------------
# Réseau Docker d'Officina (docker network ls).
RESEAU_OFFICINA=officine-os_default
PORT_PUBLIE=8080
