# --- Accès -------------------------------------------------------------------
# Code d'installation : permet de créer le premier administrateur depuis votre
# poste, puis sert de secours si un administrateur perd son mot de passe.
# Une longue phrase que vous gardez pour vous (et que vous ne réutilisez pas).
SUPERVISION_CODE_INSTALLATION=
# Durée d'une session, en heures.
SUPERVISION_SESSION_HEURES=12
# true si l'interface est servie en HTTPS (derrière Caddy).
COOKIE_SECURISE=false

# --- Sources -----------------------------------------------------------------
# auto : Prometheus s'il répond, sinon démonstration. reel | demo pour forcer.
SUPERVISION_MODE=auto
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
LOKI_URL=http://loki:3100
# Lien « Ouvrir Grafana » (facultatif), ex. https://officine.exemple.ga/supervision/
GRAFANA_URL=

# --- Notifications -------------------------------------------------------------
# Adresse de l'interface, pour les liens dans les messages (ex. https://supervision.mon-officine.ga).
URL_PUBLIQUE=
# Telegram : le même bot que les alertes d'Officina. TELEGRAM_CHAT_ID = la
# conversation de l'équipe (incidents P1/P2, SLA dépassés). Chacun renseigne
# son propre identifiant dans « Mon profil ».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail (SMTP). SMTP_HOTE au format hote:port (587 par défaut, 465 = TLS).
SMTP_HOTE=
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# Expéditeur (par défaut SMTP_UTILISATEUR).
SMTP_EXPEDITEUR=

# --- Officine ------------------------------------------------------------------
NOM_PRODUIT=Officina
FUSEAU=Africa/Libreville
# Heures d'ouverture : « zéro vente pendant 1 h » n'alerte qu'entre ces heures.
HEURE_OUVERTURE=8
HEURE_FERMETURE=20

# --- Docker --------------------------------------------------------------------
# Réseau Docker d'Officina (docker network ls).
RESEAU_OFFICINA=officine-os_default
PORT_PUBLIE=8080
