# --- Accès -------------------------------------------------------------------
# Code d'installation : permet de créer le premier administrateur depuis votre
# poste, puis sert de secours si un administrateur perd son mot de passe.
# Une longue phrase que vous gardez pour vous (et que vous ne réutilisez pas).
SUPERVISION_CODE_INSTALLATION=
# Durée d'une session, en heures.
SUPERVISION_SESSION_HEURES=12
# true si l'interface est servie en HTTPS (derrière Caddy).
COOKIE_SECURISE=false

# --- Sources -----------------------------------------------------------------
# auto : Prometheus s'il répond, sinon démonstration. reel | demo pour forcer.
SUPERVISION_MODE=auto
PROMETHEUS_URL=http://prometheus:9090
ALERTMANAGER_URL=http://alertmanager:9093
LOKI_URL=http://loki:3100
# Lien « Ouvrir Grafana » (facultatif), ex. https://officine.exemple.ga/supervision/
GRAFANA_URL=

# --- Notifications -------------------------------------------------------------
# Adresse de l'interface, pour les liens dans les messages (ex. https://supervision.mon-officine.ga).
URL_PUBLIQUE=
# Telegram : le même bot que les alertes d'Officina. TELEGRAM_CHAT_ID = la
# conversation de l'équipe (incidents P1/P2, SLA dépassés). Chacun renseigne
# son propre identifiant dans « Mon profil ».
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# E-mail (SMTP). SMTP_HOTE au format hote:port (587 par défaut, 465 = TLS).
SMTP_HOTE=
SMTP_UTILISATEUR=
SMTP_MOT_DE_PASSE=
# Expéditeur (par défaut SMTP_UTILISATEUR).
SMTP_EXPEDITEUR=

# --- Orchestration (facultatif) ------------------------------------------------
# Vides : l'outil est « non configuré » (simulé en mode démonstration).
# GitLab : jeton d'accès (lecture API + pipelines), projet = identifiant ou « groupe/projet ».
GITLAB_URL=
GITLAB_JETON=
GITLAB_PROJET=
# AWX (Ansible) : jeton personnel (Users → Tokens, portée « write » pour lancer des jobs).
AWX_URL=
AWX_JETON=
# Control-M Automation API : jeton d'API (x-api-key), ex. https://controlm.exemple.ga:8443
CONTROLM_URL=
CONTROLM_JETON=
# SonarQube / SonarCloud : jeton utilisateur, clé du projet (ex. officina).
SONAR_URL=
SONAR_JETON=
SONAR_PROJET=
# GitHub Actions (si le dépôt est sur GitHub) : jeton (actions:read/write, pull_requests:read), dépôt « proprietaire/depot ».
GITHUB_JETON=
GITHUB_DEPOT=

# --- Outils connectés (facultatifs, chacun indépendant) ------------------------
# Sentry : jeton d'organisation (project:read, event:write), organisation, projet.
SENTRY_URL=https://sentry.io
SENTRY_JETON=
SENTRY_ORG=
SENTRY_PROJET=
# Sondes externes : UptimeRobot (clé API lecture) et/ou Uptime Kuma (clé API, page /metrics).
UPTIMEROBOT_CLE=
UPTIMEKUMA_URL=
UPTIMEKUMA_CLE=
# Trivy / Grype : rapport JSON déposé (par le pipeline ou le conteneur trivy de deploy/).
TRIVY_RAPPORT=/donnees/rapports/trivy.json
# CrowdSec : API locale et clé de bouncer (cscli bouncers add supervision).
CROWDSEC_URL=
CROWDSEC_CLE=
# Wazuh : API du manager (port 55000).
WAZUH_URL=
WAZUH_UTILISATEUR=
WAZUH_MOT_DE_PASSE=
# Falco : page de métriques Prometheus (metrics.enabled, port 8765).
FALCO_METRICS_URL=
# Lynis et AIDE : rapports écrits sur le serveur, montés dans le conteneur.
LYNIS_RAPPORT=
AIDE_RAPPORT=
# Argo CD : API et jeton de compte.
ARGOCD_URL=
ARGOCD_JETON=
# Hetzner Cloud : jeton de projet (lecture).
HETZNER_JETON=
# Jaeger : API de requête (port 16686) et service à suivre.
JAEGER_URL=
JAEGER_SERVICE=gateway

# --- Officine ------------------------------------------------------------------
NOM_PRODUIT=Officina
FUSEAU=Africa/Libreville
# Heures d'ouverture : « zéro vente pendant 1 h » n'alerte qu'entre ces heures.
HEURE_OUVERTURE=8
HEURE_FERMETURE=20

# --- Docker --------------------------------------------------------------------
# Réseau Docker d'Officina (docker network ls).
RESEAU_OFFICINA=officine-os_default
PORT_PUBLIE=8080

# --- Pile de supervision livrée (deploy/installer.sh, serveur neuf) ------------
# Port /health et /metrics des services Officina, sondés par blackbox.
PORT_SERVICES=3000
# Dossier des mesures textfile (sauvegardes) lu par node-exporter.
DOSSIER_MESURES=deploy/mesures
# Accès de postgres-exporter à la base d'Officina (mêmes valeurs que le .env d'Officina).
POSTGRES_USER=officine
POSTGRES_PASSWORD=
POSTGRES_DB=postgres
POSTGRES_HOTE=postgres
# Destinataire des alertes par e-mail (avec SMTP_* ci-dessus).
ALERTES_EMAIL=
# Images scannées chaque jour par le profil trivy (séparées par des espaces).
TRIVY_IMAGES=
